# SWASTHYA BACKEND ENVIRONMENT VARIABLES

# AWS S3 Settings (For Patient Record Isolation)
# Replace with your actual IAM keys when ready. The app currently uses mock mode if these are empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=mediaccess-secure-vault

# Firebase Settings (For FaceAuth & Embeddings)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server Config
PORT=5000
